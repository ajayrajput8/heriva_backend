{
  "info": {
    "name": "Made By Her API",
    "_postman_id": "made-by-her-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"Test Customer\", \"email\": \"customer@example.com\", \"password\": \"Customer@123\", \"phone\": \"9999999999\", \"role\": \"CUSTOMER\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Village Partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"Rahul Partner\", \"email\": \"partner@example.com\", \"password\": \"Partner@123\", \"phone\": \"9999999999\", \"role\": \"VILLAGE_PARTNER\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"customer@example.com\", \"password\": \"Customer@123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Featured Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/featured"
          }
        },
        {
          "name": "Shop Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=0&size=12"
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?search=basket&page=0&size=12"
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "My Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart/items?productId=1&quantity=1"
          }
        },
        {
          "name": "My Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/addresses"
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/my"
          }
        }
      ]
    },
    {
      "name": "Village Partner",
      "item": [
        {
          "name": "Partner Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/partner/me"
          }
        },
        {
          "name": "My Women",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/partner/women"
          }
        },
        {
          "name": "Add Woman",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "Content-Type": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Sunita Devi\", \"village\": \"Sehore\", \"district\": \"Sehore\", \"state\": \"Madhya Pradesh\", \"skills\": \"Basket making\", \"story\": \"Handmade artisan\"}"
            },
            "url": "{{baseUrl}}/api/partner/women"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/dashboard"
          }
        },
        {
          "name": "Pending Partners",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/partners/pending"
          }
        }
      ]
    }
  ]
}